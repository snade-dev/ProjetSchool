generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id
  username String @unique

  MakeupExam MakeupExam[]

  MakeupSession MakeupSession[]
}

model Student {
  id          String       @id
  username    String       @unique
  name        String
  surname     String
  email       String?      @unique
  phone       String?      @unique
  address     String
  img         String?
  bloodType   String
  sex         UserSex
  createdAt   DateTime     @default(now())
  parentId    String
  parent      Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  classId     Int
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  results     Result[]
  birthday    DateTime

  ExamAverage ExamAverage[]

  StudentAnswer StudentAnswer[]
  QuizResult    QuizResult[] // Relation avec QuizResult

  Complaint Complaint[]

  Attestation Attestation[]

  TuitionPayment TuitionPayment[]

  ResultAverage ResultAverage[]

  MakeupExam MakeupExam[]
}

model Teacher {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String
  img       String?
  bloodType String
  sex       UserSex
  createdAt DateTime  @default(now())
  subjects  Subject[]
  lessons   Lesson[]
  classes   Class[]
  birthday  DateTime

  Question Question[]

  ExamCorrection ExamCorrection[]

  Quiz Quiz[]
}

model Parent {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String
  createdAt DateTime  @default(now())
  students  Student[]
}

model Class {
  id       Int    @id @default(autoincrement())
  name     String @unique
  capacity Int

  supervisorId  String?
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id], onDelete: SetNull)
  lessons       Lesson[]
  students      Student[]
  events        Event[]
  announcements Announcement[]

  Quiz Quiz[]

  Attendance Attendance[]
}

model Subject {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  teachers  Teacher[]
  lessons   Lesson[]
  results   Result[]
  semesters Semester[]
  Quiz      Quiz[]

  Attendance Attendance[]

  MakeupExam MakeupExam[]
}

model Lesson {
  id   Int    @id @default(autoincrement())
  name String
  day  Day

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId   Int
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  exams     Exam[]
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime

  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  semesterId Int
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  results    Result[]

  ExamAverage ExamAverage[]
}

model Result {
  id    Int @id @default(autoincrement())
  score Int
  classScore Float?  // Note de classe ajoutée


  examId     Int?
  exam       Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId  Int
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  semesterId Int
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  makeupExam MakeupExam? // Relation optionnelle : s'il existe, on affichera makeupExam.score
  @@unique([semesterId, studentId, subjectId]) // Contrainte pour éviter les doublons
}



model ResultAverage {
  id         Int      @id @default(autoincrement())
  average    Float
  semesterId Int
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([semesterId, studentId]) // Contrainte pour éviter les doublons
}

model ExamAverage {
  id        Int     @id @default(autoincrement())
  examId    Int
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  average   Float

  @@unique([examId, studentId]) // Contrainte pour éviter les doublons
}

model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   Int
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id], onDelete: SetNull)
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id], onDelete: SetNull)
}

model Quiz {
  id        String   @id @default(uuid())
  title     String   @unique
  date      DateTime
  duration  Int // Durée de l'examen en minutes
  published Boolean  @default(false) // Contrôle de la publication des résultats
  createdAt DateTime @default(now())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  classId   Int
  class     Class    @relation(fields: [classId], references: [id])
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])

  questions     Question[]
  StudentAnswer StudentAnswer[]
  QuizResult    QuizResult[] // Relation avec QuizResult

  ExamCorrection ExamCorrection[]

  Complaint Complaint[]
}

model Question {
  id           String  @id @default(uuid())
  questionText String
  createdBy    String
  teacher      Teacher @relation(fields: [createdBy], references: [id])
  quizId       String
  quiz         Quiz    @relation(fields: [quizId], references: [id])

  StudentAnswer StudentAnswer[]
}

model StudentAnswer {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  questionId  String
  question    Question @relation(fields: [questionId], references: [id])
  answerText  String
  score       Float? // Note attribuée par l'enseignant pour cette réponse
  submittedAt DateTime @default(now())

  quizResultId String? // Clé étrangère vers QuizResult
  quizResult   QuizResult? @relation(fields: [quizResultId], references: [id]) // Relation avec QuizResult

  @@unique([studentId, quizId, questionId]) // Contrainte pour éviter les doublons
  @@index([studentId])
  @@index([quizId])
  @@index([questionId])
}

model QuizResult {
  id         String  @id @default(uuid())
  studentId  String
  student    Student @relation(fields: [studentId], references: [id])
  quizId     String
  quiz       Quiz    @relation(fields: [quizId], references: [id])
  totalScore Float // Note totale sur 20 pour l'étudiant

  studentAnswers StudentAnswer[] // Relation avec StudentAnswer

  @@unique([studentId, quizId]) // Contrainte pour éviter les doublons
}

model ExamCorrection {
  id              String   @id @default(uuid())
  quizId          String
  quiz            Quiz     @relation(fields: [quizId], references: [id])
  correctedBy     String
  teacher         Teacher  @relation(fields: [correctedBy], references: [id])
  anonymousReview Boolean  @default(true)
  correctionDate  DateTime @default(now())
}

model Complaint {
  id          String          @id @default(uuid())
  title       String          @db.VarChar(255)
  description String
  status      ComplaintStatus @default(PENDING)
  createdAt   DateTime        @default(now())

  // Auteur obligatoire (étudiant uniquement)
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  // Cible obligatoire (quiz concerné)
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id])

  @@index([studentId])
  @@index([quizId])
}

model Attestation {
  id           String        @id @default(uuid())
  title        String
  description  String
  status       RequestStatus @default(PENDING)
  requestDate  DateTime      @default(now())
  resolvedDate DateTime?
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model TuitionPayment {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month       Int // Représente le mois (1 = janvier, 12 = décembre)
  year        Int // Année du paiement
  amount      Float // Montant payé pour la scolarité
  paymentDate DateTime // Date à laquelle le paiement a été effectué
  createdAt   DateTime @default(now())

  // Pour éviter que le même étudiant ne paie deux fois pour le même mois/année
  @@unique([studentId, month, year])
}

enum RequestStatus {
  PENDING    @map("En attente")
  PROCESSING @map("En traitement")
  COMPLETED  @map("Terminé")
  REJECTED   @map("Rejeté")
}

enum ComplaintStatus {
  PENDING      @map("En attente")
  UNDER_REVIEW @map("En cours")
  RESOLVED     @map("Résolu")
  REJECTED     @map("Rejeté")
}

model Semester {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  results  Result[]
  exams    Exam[]
  subjects Subject[]

  ResultAverage ResultAverage[]

  MakeupSession MakeupSession[]
}

model MakeupSession {
  id          String   @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime

  // La session concerne une matière et un semestre donnés
  semesterId Int
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  // L'admin qui crée la session
  createdById String
  createdBy   Admin    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  // Inscriptions des étudiants à cette session
  registrations MakeupExam[]

  // (Optionnel) Contrainte pour éviter des sessions en doublon pour la même matière/semestre au même créneau
  @@unique([semesterId, startTime])
}

model MakeupExam {
  id             String         @id @default(uuid())
  studentId      String
  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  sessionId      String
  session        MakeupSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  subjectId      Int
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  enrollmentDate DateTime       @default(now())

  score          Float?
  gradedById     String?
  gradedBy       Admin?         @relation(fields: [gradedById], references: [id])
  gradedAt       DateTime?

  // Lien vers le résultat concerné par la note de rattrapage
  resultId       Int?           @unique
  result         Result?        @relation(fields: [resultId], references: [id])

  // Contrainte : un étudiant ne peut s'inscrire qu'une seule fois pour une même session et la même matière.
  @@unique([studentId, sessionId, subjectId])
}



enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}
