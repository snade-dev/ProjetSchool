
generator client {
  provider = "prisma-client-js"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id
  username String @unique

  MakeupExam MakeupExam[]

  MakeupSession MakeupSession[]
}

model Student {
  id          String       @id
  username    String       @unique
  name        String
  surname     String
  email       String?      @unique
  phone       String?      @unique
  address     String
  img         String?
  bloodType   String
  sex         UserSex
  createdAt   DateTime     @default(now())
  // W05 — Student.parentId supprimé : les tuteurs viennent de StudentGuardian
  // W03 — Student.classId supprimé : la classe vient de l'Enrollment de l'année active
  attendances Attendance[]
  results     Result[]
  birthday    DateTime

  ExamAverage ExamAverage[]

  StudentAnswer StudentAnswer[]
  QuizResult    QuizResult[] // Relation avec QuizResult

  Complaint Complaint[]

  Attestation Attestation[]

  ResultAverage ResultAverage[]

  MakeupExam MakeupExam[]

  invoices Invoice[] // back-relation S03

  // W03 — inscriptions par année scolaire (§2.1.3) : remplacent Student.classId
  enrollments Enrollment[]

  // W05 — tuteurs multiples (§2.2.3) : remplacent Student.parentId
  guardians StudentGuardian[]

  // W15 — dossier disciplinaire (§2.3.7)
  observations Observation[]

  // V02 — rattachement multi-établissements (W01 : schoolId explicite, plus de défaut)
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

// W03 — statut d'une inscription (§2.1.3)
enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  LEFT
  GRADUATED
  REPEATED
}

// W03 — inscription d'un élève dans UNE classe pour UNE année scolaire (§2.1.3).
// Remplace Student.classId ; l'historique complet du parcours est conservé.
model Enrollment {
  id           Int              @id @default(autoincrement())
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId      Int
  class        Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolYearId Int
  schoolYear   SchoolYear       @relation(fields: [schoolYearId], references: [id])
  status       EnrollmentStatus @default(ACTIVE)
  enrolledAt   DateTime         @default(now())

  // Une seule inscription par élève et par année
  @@unique([studentId, schoolYearId])
  @@index([classId])
}

model Teacher {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String
  img       String?
  bloodType String
  sex       UserSex
  createdAt DateTime  @default(now())
  subjects  Subject[]
  lessons   Lesson[]
  classes   Class[]
  birthday  DateTime

  Question Question[]

  ExamCorrection ExamCorrection[]

  Quiz Quiz[]

  employee Employee? // back-relation S03 (utilisée par story 10)

  // V02 — rattachement multi-établissements (W01 : schoolId explicite, plus de défaut)
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Parent {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String
  createdAt DateTime  @default(now())
  // W05 — les élèves du parent passent par StudentGuardian (N-N + droits)
  guardians StudentGuardian[]

  // W15 — justifications d'absence déposées (§2.3.6)
  justifications AbsenceJustification[]

  // V02 — rattachement multi-établissements (W01 : schoolId explicite, plus de défaut)
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

// W05 — tuteur d'un élève (§2.2.3) : remplace Student.parentId (1-N → N-N).
// Chaque lien porte le type de relation et des droits différenciés :
// canPay (paiements), canViewGrades (notes/bulletins), canPickup (récupération,
// informatif — affiché sur la fiche élève côté admin).
model StudentGuardian {
  id            Int     @id @default(autoincrement())
  studentId     String
  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId      String
  parent        Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  relationship  String // père, mère, tuteur légal, tuteur de fait
  isLegal       Boolean @default(true)
  canPay        Boolean @default(true)
  canViewGrades Boolean @default(true)
  canPickup     Boolean @default(false)

  // Un même parent n'est tuteur d'un élève qu'une fois
  @@unique([studentId, parentId])
  @@index([parentId])
}

// W02 — niveau scolaire (§2.1.4) : créé librement par l'école (« CP », « 6ème »…).
// `order` donne la hiérarchie (utilisée par le futur passage d'année, W04).
model Level {
  id       Int     @id @default(autoincrement())
  name     String
  order    Int
  cycle    String? // préscolaire / primaire / collège / lycée (libre)
  schoolId Int
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes  Class[]

  @@unique([schoolId, name])
}

model Class {
  id       Int    @id @default(autoincrement())
  name     String // W02 — unicité PAR ÉCOLE ET PAR ANNÉE (@@unique en bas de modèle)
  capacity Int
  // V01 — régime d'évaluation de la classe (trimestres ou compositions mensuelles)
  // W09 — + COMBINED (§2.3.1 système 3) : la classe voit les périodes des DEUX régimes
  evaluationSystem EvaluationSystem @default(TRIMESTER)

  // W09 — pondération devoirs vs composition (en %, §2.3.1 système 2/3) :
  // moyenne matière = classScore × (homeworkWeight/100) + examScore × (1 − homeworkWeight/100)
  // sur les périodes TRIMESTER uniquement (les compositions MONTHLY ne pondèrent pas).
  // 50 = comportement historique H17 (moyenne simple des deux notes).
  homeworkWeight Int @default(50)

  // W02 — niveau de la classe (§2.1.4). Nullable en base (classes historiques),
  // mais l'UI l'exige pour toute création/édition (validation Zod).
  levelId Int?
  level   Level? @relation(fields: [levelId], references: [id], onDelete: SetNull)

  // W02 — une classe appartient à UNE année scolaire (§2.1.5)
  schoolYearId Int
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])

  supervisorId  String?
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id], onDelete: SetNull)
  lessons       Lesson[]
  // W03 — inscriptions par année (remplacent Student.classId / Class.students)
  enrollments   Enrollment[]
  events        Event[]
  announcements Announcement[]

  Quiz Quiz[]

  Attendance Attendance[]

  feeStructures FeeStructure[] // back-relation S03

  // W08 — matières enseignées dans la classe avec leur coefficient (§2.1.6)
  classSubjects ClassSubject[]

  // W14 — devoirs à faire publiés pour la classe (§2.3.8)
  homeworks Homework[]

  // V02 — rattachement multi-établissements (W01 : schoolId explicite, plus de défaut)
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // W02 — « 6ème A » réutilisable chaque année (remplace @@unique([schoolId, name]) de W01)
  @@unique([schoolId, schoolYearId, name])
}

// W08 — matière ENSEIGNÉE dans une classe, avec son coefficient (§2.1.6).
// Le coefficient est fixe pour l'année (la classe appartient à UNE année, W02).
// Backfillé depuis les Lessons existantes (coefficient 1 = comportement inchangé).
// Une matière sans ligne ClassSubject compte pour 1 dans les moyennes pondérées.
model ClassSubject {
  id          Int     @id @default(autoincrement())
  classId     Int
  class       Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   Int
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  coefficient Int     @default(1)

  @@unique([classId, subjectId])
  @@index([subjectId])
}

model Subject {
  id        Int        @id @default(autoincrement())
  name      String // W01 — unicité PAR ÉCOLE (@@unique en bas de modèle)
  teachers  Teacher[]
  lessons   Lesson[]
  results   Result[]
  semesters Semester[]
  Quiz      Quiz[]

  Attendance Attendance[]

  MakeupExam MakeupExam[]

  // W08 — classes où la matière est enseignée (coefficient par classe)
  classSubjects ClassSubject[]

  // W14 — devoirs à faire de la matière (§2.3.8)
  homeworks Homework[]

  // V02 — rattachement multi-établissements (W01 : schoolId explicite, plus de défaut)
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // W01 — unicité par école
  @@unique([schoolId, name])
}

model Lesson {
  id   Int    @id @default(autoincrement())
  name String
  day  Day
  // Créneau horaire hebdomadaire (seule l'heure du jour compte) — emploi du temps
  startTime DateTime?
  endTime   DateTime?

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId   Int
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  exams     Exam[]
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime

  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  semesterId Int
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  results    Result[]

  ExamAverage ExamAverage[]
}

model Result {
  id         Int    @id @default(autoincrement())
  score      Int
  classScore Float? // Note de classe ajoutée

  examId     Int?
  exam       Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId  Int
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  semesterId Int
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  makeupExam MakeupExam? // Relation optionnelle : s'il existe, on affichera makeupExam.score
  // Contrainte pour éviter les doublons
  @@unique([semesterId, studentId, subjectId])
}

model ResultAverage {
  id         Int      @id @default(autoincrement())
  average    Float
  // W08 — bulletin périmé (§2.1.6) : passe à true quand un coefficient de la
  // classe change après calcul ; remis à false par la régénération explicite.
  stale      Boolean  @default(false)
  semesterId Int
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Contrainte pour éviter les doublons
  @@unique([semesterId, studentId])
}

model ExamAverage {
  id        Int     @id @default(autoincrement())
  examId    Int
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  average   Float

  // Contrainte pour éviter les doublons
  @@unique([examId, studentId])
}

model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean
  sessionDay SessionDay  @default(MORNING) // Nouveau champ pour indiquer le créneau (matin ou soir)
  // W15 — « absent justifié » (§2.3.6) : posé UNIQUEMENT par l'acceptation
  // d'une AbsenceJustification (decideJustification), jamais à la saisie.
  justified Boolean @default(false)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   Int
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // W15 — justification déposée par un tuteur (une seule par absence)
  justification AbsenceJustification?
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  // V02 — rattachement multi-établissements (W01 : schoolId explicite, plus de défaut)
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  // V02 — rattachement multi-établissements (W01 : schoolId explicite, plus de défaut)
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Quiz {
  id        String   @id @default(uuid())
  title     String // W01 — unicité PAR ÉCOLE (@@unique en bas de modèle)
  date      DateTime
  duration  Int // Durée de l'examen en minutes
  published Boolean  @default(false) // Contrôle de la publication des résultats
  createdAt DateTime @default(now())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  classId   Int
  class     Class    @relation(fields: [classId], references: [id])
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])

  questions     Question[]
  StudentAnswer StudentAnswer[]
  QuizResult    QuizResult[] // Relation avec QuizResult

  ExamCorrection ExamCorrection[]

  Complaint Complaint[]

  // V02 — rattachement multi-établissements (W01 : schoolId explicite, plus de défaut)
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // W01 — unicité par école
  @@unique([schoolId, title])
}

model Question {
  id           String  @id @default(uuid())
  questionText String
  createdBy    String
  // Restrict volontaire : un enseignant avec des questions ne se supprime pas
  teacher      Teacher @relation(fields: [createdBy], references: [id])
  quizId       String
  quiz         Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  StudentAnswer StudentAnswer[]
}

model StudentAnswer {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText  String
  score       Float? // Note attribuée par l'enseignant pour cette réponse
  submittedAt DateTime @default(now())

  quizResultId String? // Clé étrangère vers QuizResult
  quizResult   QuizResult? @relation(fields: [quizResultId], references: [id], onDelete: SetNull) // Relation avec QuizResult

  // Contrainte pour éviter les doublons
  @@unique([studentId, quizId, questionId])
  @@index([studentId])
  @@index([quizId])
  @@index([questionId])
}

model QuizResult {
  id         String  @id @default(uuid())
  studentId  String
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId     String
  quiz       Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  totalScore Float // Note totale sur 20 pour l'étudiant

  studentAnswers StudentAnswer[] // Relation avec StudentAnswer

  // Contrainte pour éviter les doublons
  @@unique([studentId, quizId])
}

model ExamCorrection {
  id              String   @id @default(uuid())
  quizId          String
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  correctedBy     String
  // Restrict volontaire : un enseignant avec des corrections ne se supprime pas
  teacher         Teacher  @relation(fields: [correctedBy], references: [id])
  anonymousReview Boolean  @default(true)
  correctionDate  DateTime @default(now())
}

model Complaint {
  id          String          @id @default(uuid())
  title       String          @db.VarChar(255)
  description String
  status      ComplaintStatus @default(PENDING)
  createdAt   DateTime        @default(now())

  // Auteur obligatoire (étudiant uniquement)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Cible obligatoire (quiz concerné)
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([quizId])
}

model Attestation {
  id           String        @id @default(uuid())
  title        String
  description  String
  status       RequestStatus @default(PENDING)
  requestDate  DateTime      @default(now())
  resolvedDate DateTime?
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// W11 — TuitionPayment supprimé : la scolarité vit sur Invoice/Payment.
// La migration 20260715..._w11_finance_debt convertit les lignes restantes
// (Invoice PAID + Payment, generationKey `legacy-{id}`) avant le DROP TABLE.

enum RequestStatus {
  PENDING @map("En attente")
  PROCESSING @map("En traitement")
  COMPLETED @map("Terminé")
  REJECTED @map("Rejeté")
}

enum ComplaintStatus {
  PENDING @map("En attente")
  UNDER_REVIEW @map("En cours")
  RESOLVED @map("Résolu")
  REJECTED @map("Rejeté")
}

// V01 — régime d'évaluation : trimestres (3/an) ou compositions mensuelles.
// W09 — COMBINED (§2.3.1 système 3) : la CLASSE suit les deux calendriers en
// parallèle (compositions mensuelles hors mois de trimestre + trimestres).
// Une PÉRIODE (Semester.system) reste TRIMESTER ou MONTHLY : le régime de
// CALCUL d'un bulletin est décidé par la période, pas par la classe.
enum EvaluationSystem {
  TRIMESTER
  MONTHLY
  COMBINED
}

model Semester {
  id       Int       @id @default(autoincrement())
  name     String // W01 — unicité PAR ÉCOLE (@@unique en bas de modèle)
  // V01 — « période d'évaluation » : régime + ordre chronologique + libellé bulletin
  system   EvaluationSystem @default(TRIMESTER)
  order    Int              @default(1)
  label    String?
  results  Result[]
  exams    Exam[]
  subjects Subject[]

  ResultAverage ResultAverage[]

  MakeupSession MakeupSession[]

  // W02 — une période d'évaluation appartient à UNE année scolaire
  schoolYearId Int
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])

  // V02 — rattachement multi-établissements (W01 : schoolId explicite, plus de défaut)
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // W04 — unicité par école ET par année : le passage d'année reconduit les
  // périodes avec le MÊME nom (« Trimestre 1 ») sur la nouvelle année.
  @@unique([schoolId, schoolYearId, name])
}

model MakeupSession {
  id          String   @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime

  // La session concerne une matière et un semestre donnés
  semesterId Int
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  // L'admin qui crée la session
  createdById String
  createdBy   Admin    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  // Inscriptions des étudiants à cette session
  registrations MakeupExam[]

  // (Optionnel) Contrainte pour éviter des sessions en doublon pour la même matière/semestre au même créneau
  @@unique([semesterId, startTime])
}

model MakeupExam {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  sessionId String
  session   MakeupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  enrollmentDate DateTime @default(now())

  score      Float?
  gradedById String?
  gradedBy   Admin?    @relation(fields: [gradedById], references: [id])
  gradedAt   DateTime?

  // Lien vers le résultat concerné par la note de rattrapage
  resultId Int?    @unique
  result   Result? @relation(fields: [resultId], references: [id])

  // Contrainte : un étudiant ne peut s'inscrire qu'une seule fois pour une même session et la même matière.
  @@unique([studentId, sessionId, subjectId])
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum SessionDay {
  MORNING
  EVENING
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String? @default("")
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")

  // V02 — école de rattachement. Depuis W06 : CONTEXTE ACTIF de la session
  // (école + rôle courants, alimentés par le sélecteur d'espace) ; la vérité
  // des rattachements est UserSchoolMembership. null = superadmin plateforme.
  schoolId Int?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  // W06 — rattachements du compte (1 compte, N écoles/rôles)
  memberships UserSchoolMembership[]
}

// W06 — rattachement d'un compte à une école avec un rôle (§2.2.8, §2.7.10).
// Un même compte peut avoir plusieurs memberships (écoles ou rôles différents) ;
// User.schoolId/User.role restent le contexte actif choisi via le sélecteur
// d'espace. Le superadmin (rôle global) n'a AUCUNE membership.
model UserSchoolMembership {
  id       Int     @id @default(autoincrement())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId Int
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role     String // admin, teacher, parent, student (rôles élargis en W07)
  active   Boolean @default(true)

  @@unique([userId, schoolId, role])
  @@index([schoolId])
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ---- M7 Administration ----
model SchoolYear {
  id        Int      @id @default(autoincrement())
  name      String                    // "2025-2026" — W01 : unicité PAR ÉCOLE
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)  // UNE seule active (invariant applicatif)
  // Relations finance/RH ajoutées en S03
  invoices        Invoice[]
  expenses        Expense[]
  feeStructures   FeeStructure[]
  salaryPayments  SalaryPayment[]
  // W02 — classes et périodes d'évaluation rattachées à l'année
  classes         Class[]
  semesters       Semester[]
  // W03 — inscriptions des élèves pour cette année
  enrollments     Enrollment[]

  // V02 — rattachement multi-établissements (W01 : schoolId explicite, plus de défaut)
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // W01 — unicité par école
  @@unique([schoolId, name])
}

model School {                  // établissement (ex-singleton SchoolSettings)
  id          Int     @id @default(autoincrement())
  name        String                  // nom de l'établissement (en-têtes PDF)
  address     String?
  phone       String?
  email       String?
  logo        String?                 // URL (upload local /uploads)
  currency    String  @default("FCFA")
  legalFooter String?                 // pied de page factures/reçus
  // Thème de l'application (hex "#RRGGBB") — null = palette par défaut
  themePrimary   String?              // couleur principale (lamaSky)
  themeSecondary String?              // couleur secondaire (lamaPurple)
  themeAccent    String?              // couleur d'accent (lamaYellow)
  // V02 — SaaS multi-établissements
  slug      String   @unique          // identifiant lisible (URL, support)
  active    Boolean  @default(true)   // coupure plateforme (superadmin)
  createdAt DateTime @default(now())
  // W13 — config SMTP PROPRE à l'école (§2.6.3). emailEnabled = l'école utilise
  // SON serveur ; sinon fallback plateforme (env SMTP_HOST/PORT/USER/PASS/FROM),
  // et sans aucun des deux → canal in-app seulement, jamais bloquant.
  // AMÉLIORATION NOTÉE : smtpPass est stocké en clair — à chiffrer au repos
  // (pgcrypto ou clé applicative) dans une story ultérieure.
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPass     String?                // write-only côté UI (jamais renvoyé au client)
  smtpFrom     String?                // adresse expéditeur ("École <no-reply@...>")
  emailEnabled Boolean @default(false)

  // W16 — messagerie élève↔enseignant (§2.6.5 : « optionnel, désactivable par
  // l'école ») : false = les élèves ne peuvent pas écrire à leurs enseignants.
  studentMessagingEnabled Boolean @default(false)

  users             User[]
  classes           Class[]
  levels            Level[] // W02
  subjects          Subject[]
  teachers          Teacher[]
  students          Student[]
  parents           Parent[]
  schoolYears       SchoolYear[]
  semesters         Semester[]
  announcements     Announcement[]
  events            Event[]
  employees         Employee[]
  expenseCategories ExpenseCategory[]
  feeStructures     FeeStructure[]
  quizzes           Quiz[]
  subscription      SchoolSubscription? // V05
  memberships       UserSchoolMembership[] // W06
  homeworks         Homework[] // W14
  observations      Observation[] // W15
  absenceJustifications AbsenceJustification[] // W15
  messages          Message[] // W16

  @@map("SchoolSettings")
}

// ---- M4 Finance ----
enum FeePeriod {
  MONTHLY
  YEARLY
  ONE_TIME
}

model FeeStructure {            // grille des frais par classe et année
  id           Int        @id @default(autoincrement())
  label        String                 // "Scolarité mensuelle", "Inscription"…
  amount       Int                    // FCFA
  period       FeePeriod
  classId      Int
  class        Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolYearId Int
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  lines        InvoiceLine[]
  // W11 — échéancier détaillé (§2.4.2) : mois payables + montants par mois.
  // Vide = comportement uniforme (une facture chaque mois au montant `amount`).
  installments FeeInstallment[]
  // W01 — reste scopée par école via classId (une Class appartient à UNE école)
  @@unique([classId, schoolYearId, label])

  // V02 — rattachement multi-établissements (W01 : schoolId explicite, plus de défaut)
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

// W11 — échéancier d'une FeeStructure MONTHLY (§2.4.2) : l'école choisit les
// mois payables (7, 8, 9, 10 mensualités…) et le montant de CHAQUE mois (les
// mensualités ne sont pas forcément égales). Le batch generateMonthlyInvoices
// ne facture le mois M que s'il figure ici (sinon : montant uniforme).
model FeeInstallment {
  id             Int          @id @default(autoincrement())
  feeStructureId Int
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  month          Int // 1-12 (mois payable choisi par l'école)
  amount         Int // FCFA — montant de CE mois

  @@unique([feeStructureId, month])
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id            String        @id @default(uuid())
  reference     String        @unique          // "FAC-2025-00042" (compteur, story-05)
  status        InvoiceStatus @default(ISSUED)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  month         Int?                           // 1-12 si facture mensuelle auto
  generationKey String?       @unique          // "auto-{studentId}-{schoolYearId}-{month}" → idempotence du batch
  total         Int                            // dénormalisé = somme des lignes (recalculé à chaque écriture)
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolYearId  Int
  schoolYear    SchoolYear    @relation(fields: [schoolYearId], references: [id])
  createdById   String                          // User.id (admin)
  createdAt     DateTime      @default(now())
  reminderNote  String?                         // note libre de relance (story-08)
  remindedAt    DateTime?                       // horodatage de la dernière relance (story-08)
  lines         InvoiceLine[]
  payments      Payment[]
  @@index([studentId])
  @@index([status])
  @@index([schoolYearId, month])
}

model InvoiceLine {
  id             Int           @id @default(autoincrement())
  label          String
  quantity       Int           @default(1)
  unitAmount     Int                             // FCFA
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructureId Int?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CHEQUE
}

model Payment {
  id           String        @id @default(uuid())
  amount       Int
  method       PaymentMethod @default(CASH)
  paidAt       DateTime      @default(now())
  reference    String?                          // n° transaction Mobile Money / chèque
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedById String                           // User.id (admin caissier)
  createdAt    DateTime      @default(now())
  @@index([invoiceId])
  @@index([paidAt])
}

model ExpenseCategory {
  id       Int       @id @default(autoincrement())
  name     String                     // "Fournitures", "Électricité", "Loyer"… — W01 : unicité PAR ÉCOLE
  expenses Expense[]

  // V02 — rattachement multi-établissements (W01 : schoolId explicite, plus de défaut)
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // W01 — unicité par école
  @@unique([schoolId, name])
}

model Expense {
  id           String          @id @default(uuid())
  label        String
  amount       Int
  date         DateTime
  supplier     String?
  receiptImg   String?                          // justificatif Cloudinary
  method       PaymentMethod   @default(CASH)
  notes        String?
  categoryId   Int
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  schoolYearId Int
  schoolYear   SchoolYear      @relation(fields: [schoolYearId], references: [id])
  createdById  String
  createdAt    DateTime        @default(now())
  @@index([date])
  @@index([categoryId])
}

// ---- M5 RH / Paie ----
model Employee {
  id         String    @id @default(uuid())
  teacherId  String?   @unique         // lien optionnel vers Teacher ; null = staff (gardien, secrétaire…)
  teacher    Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  name       String
  surname    String
  position   String                    // "Enseignant", "Secrétaire", "Gardien"…
  phone      String?
  email      String?
  hireDate   DateTime
  baseSalary Int                       // salaire mensuel brut, FCFA
  active     Boolean   @default(true)
  salaries   SalaryPayment[]

  // V02 — rattachement multi-établissements (W01 : schoolId explicite, plus de défaut)
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

enum SalaryStatus {
  PENDING
  PAID
}

model SalaryPayment {
  id           String        @id @default(uuid())
  month        Int                     // 1-12
  year         Int
  baseAmount   Int                     // copie du baseSalary au moment de la génération
  bonuses      Int           @default(0)
  deductions   Int           @default(0)
  netAmount    Int                     // base + bonuses - deductions (recalculé côté serveur)
  status       SalaryStatus  @default(PENDING)
  paidAt       DateTime?
  method       PaymentMethod @default(CASH)
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schoolYearId Int
  schoolYear   SchoolYear    @relation(fields: [schoolYearId], references: [id])
  @@unique([employeeId, month, year])
}

// ---------------------------------------------------------------------------
// W10 — Journal d'audit (§2.11) : APPEND-ONLY.
// RÈGLE ABSOLUE : aucune server action / aucun code applicatif ne fait
// d'update ou de delete sur cette table — le helper src/lib/audit.ts n'expose
// QUE la création. Personne (pas même le superadmin) ne modifie une entrée ;
// l'immuabilité au niveau DB (trigger/permissions) viendra plus tard.
// Volontairement SANS relation Prisma (pas de cascade : supprimer un user ou
// une école ne doit JAMAIS effacer son historique d'audit).
// ---------------------------------------------------------------------------

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  at       DateTime @default(now())
  userId   String? // qui (User.id) — null si action système/anonyme
  role     String? // rôle actif au moment de l'action
  schoolId Int? // école concernée — null = action plateforme pure
  action   String // convention "module.verbe" : "note.update", "payment.create"…
  entity   String // modèle + id concerné, ex "Result#42"
  before   Json? // ancienne valeur (champs pertinents seulement)
  after    Json? // nouvelle valeur (champs pertinents seulement)
  reason   String? // motif (obligatoire pour les actions sensibles, §2.11.3)
  ip       String?

  @@index([schoolId, at])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// W12 — Notifications in-app (§2.6.1). Le destinataire est un COMPTE de
// connexion (User.id — les entités métier Teacher/Student/Parent partagent
// l'id de leur User). Volontairement SANS relation Prisma (comme AuditLog) :
// supprimer un user/une école n'efface pas l'historique, et le helper
// src/lib/notify.ts n'échoue jamais l'action métier. `type` est une String
// libre dont les valeurs vivent dans src/lib/notificationTypes.ts
// (ABSENCE, GRADE, REPORT_CARD, PAYMENT, ANNOUNCEMENT, HOMEWORK, MESSAGE —
// HOMEWORK/MESSAGE seront émis par W14/W16). Rétention : les notifications
// LUES de plus de 90 jours sont purgées au chargement de /list/notifications.
// ---------------------------------------------------------------------------

model Notification {
  id        Int       @id @default(autoincrement())
  userId    String // destinataire (User.id)
  schoolId  Int // école émettrice (contexte de l'événement)
  type      String // cf. notificationTypes.ts
  title     String
  body      String
  link      String? // route interne ("/list/attendances", "/list/invoices/{id}"…)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// W12 — préférence par type : ABSENCE de ligne = activé par défaut (les DEUX
// canaux). W13 — `enabled` = canal in-app, `emailEnabled` = canal email
// (types critiques ABSENCE / REPORT_CARD / PAYMENT uniquement) ; les deux
// toggles sont indépendants.
model NotificationPreference {
  id           Int     @id @default(autoincrement())
  userId       String // User.id
  type         String // cf. notificationTypes.ts
  enabled      Boolean @default(true)
  emailEnabled Boolean @default(true) // W13 — canal email

  @@unique([userId, type])
}

// ---------------------------------------------------------------------------
// W14 — Devoirs à faire (§2.3.8). V1 : publication (enseignant) + consultation
// (élève/parent/direction) UNIQUEMENT — pas de dépôt en ligne ni de correction
// (explicitement V2). `teacherId` est le User.id de l'AUTEUR (convention du
// repo : Invoice.createdById, Expense.createdById) — volontairement SANS FK
// vers Teacher car admin/director peuvent aussi publier (toute classe de
// l'école) et n'ont pas de profil Teacher.
// ---------------------------------------------------------------------------

model Homework {
  id        Int      @id @default(autoincrement())
  title     String
  content   String // consignes (texte libre)
  dueDate   DateTime // date de rendu
  classId   Int
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String // User.id de l'auteur (teacher, admin ou director)
  fileUrl   String? // pièce jointe (flux /api/upload existant)
  createdAt DateTime @default(now())

  // W01 — cohérence multi-tenant : entité racine rattachée à son école
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([classId, dueDate])
  @@index([teacherId])
}

// ---------------------------------------------------------------------------
// W15 — Observations & discipline (§2.3.7). Chaque observation est datée et
// signée par son auteur (`authorId` = User.id, volontairement SANS FK — même
// convention que Homework.teacherId : admin/director/supervisor n'ont pas de
// profil Teacher). `kind` est une String libre dont les valeurs vivent dans
// src/lib/observation.ts (POSITIVE, NEUTRAL, NEGATIVE).
// Confidentialité (§2.7.8) : sharedWithParents=false → JAMAIS visible du
// parent ni de l'élève ; seules les observations partagées vont au bulletin.
// ---------------------------------------------------------------------------

model Observation {
  id                Int      @id @default(autoincrement())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorId          String // User.id de l'auteur (teacher, supervisor, director, admin)
  kind              String // cf. src/lib/observation.ts (POSITIVE, NEUTRAL, NEGATIVE)
  content           String
  sharedWithParents Boolean  @default(true)
  createdAt         DateTime @default(now())

  // W01 — cohérence multi-tenant : entité racine rattachée à son école
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([schoolId, createdAt])
}

// ---------------------------------------------------------------------------
// W15 — Justification d'absence (§2.3.6) : le PARENT (tuteur StudentGuardian)
// justifie une absence de son enfant (motif + document scanné optionnel), la
// direction (admin/director/supervisor) accepte ou refuse. Accepter pose
// Attendance.justified=true (« Absent (justifié) »). Statuts utilisés de
// l'enum RequestStatus existante : PENDING → COMPLETED (acceptée) / REJECTED.
// ---------------------------------------------------------------------------

model AbsenceJustification {
  id           Int        @id @default(autoincrement())
  attendanceId Int        @unique // une justification par absence
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  parentId     String
  parent       Parent     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  reason       String
  fileUrl      String? // document scanné (flux /api/upload existant)
  status       RequestStatus @default(PENDING)
  decidedById  String? // User.id du décideur (admin/director/supervisor)
  decidedAt    DateTime?
  decisionNote String? // motif de refus optionnel
  createdAt    DateTime @default(now())

  // W01 — cohérence multi-tenant : entité racine rattachée à son école
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// V05 — Abonnements SaaS : les écoles paient pour utiliser la plateforme.
// Encaissement MANUEL (espèces, Orange Money, virement) par le superadmin.
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id           Int     @id @default(autoincrement())
  name         String  @unique          // « Essentiel », « Premium »…
  priceMonthly Int                      // FCFA / mois (entiers, H01)
  maxStudents  Int?                     // plafond d'élèves (null = illimité)
  active       Boolean @default(true)   // un plan coupé n'est plus proposable
  createdAt    DateTime @default(now())

  subscriptions SchoolSubscription[]
}

enum SubscriptionStatus {
  TRIAL      // essai gratuit (jusqu'à trialEndsAt)
  ACTIVE     // payé (paidUntil dans le futur)
  PAST_DUE   // échu depuis moins de 15 jours (grâce)
  SUSPENDED  // échu au-delà de la grâce → blocage (V06)
}

model SchoolSubscription {
  id          Int                @id @default(autoincrement())
  schoolId    Int                @unique
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId      Int
  plan        SubscriptionPlan   @relation(fields: [planId], references: [id])
  status      SubscriptionStatus @default(TRIAL)
  trialEndsAt DateTime?          // fin d'essai (attribution initiale : +30 j)
  paidUntil   DateTime?          // couvert jusqu'à cette date par les paiements
  createdAt   DateTime           @default(now())

  payments SubscriptionPayment[]
}

model SubscriptionPayment {
  id             Int                @id @default(autoincrement())
  subscriptionId Int
  subscription   SchoolSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Int                // FCFA réellement reçus
  months         Int                // nombre de mois couverts
  method         String             // CASH / ORANGE_MONEY / BANK_TRANSFER…
  reference      String?            // n° de transaction / reçu
  note           String?
  paidAt         DateTime           @default(now())
}

// ---------------------------------------------------------------------------
// W16 — Messagerie interne 1-à-1 (§2.6.5). V1 : texte + pièce jointe, sans
// groupes ni vocal. senderId/receiverId sont des User.id (convention du repo :
// Homework.teacherId, Notification.userId — volontairement SANS FK vers User,
// tous les rôles école peuvent écrire). Les RÈGLES de mise en relation sont
// codées en dur dans src/lib/messaging.ts (canMessage) : parent↔direction,
// parent↔enseignant d'un de ses enfants, enseignant↔enseignant/direction,
// direction↔personnel, élève↔enseignant de sa classe si l'école l'a activé
// (School.studentMessagingEnabled) ; parent↔parent, élève↔élève et tout
// inter-écoles INTERDITS. Toute communication est archivée par l'école : la
// direction peut consulter (page supervision, chaque consultation auditée).
// ---------------------------------------------------------------------------

model Message {
  id         Int       @id @default(autoincrement())
  schoolId   Int // école du fil (celle de l'expéditeur — inter-écoles interdit)
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  senderId   String // User.id de l'expéditeur
  receiverId String // User.id du destinataire
  content    String
  fileUrl    String? // pièce jointe (flux /api/upload existant, image ou PDF)
  readAt     DateTime? // marqué à l'ouverture du fil par le destinataire
  createdAt  DateTime  @default(now())

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, readAt])
  @@index([schoolId, createdAt])
}
