generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id
  username String @unique
}

model Student {
  id          String       @id
  username    String       @unique
  name        String
  surname     String
  email       String?      @unique
  phone       String?      @unique
  address     String
  img         String?
  bloodType   String
  sex         UserSex
  createdAt   DateTime     @default(now())
  parentId    String
  parent      Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  classId     Int
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  results     Result[]
  birthday    DateTime

  ExamAverage ExamAverage[]

  StudentAnswer StudentAnswer[]
}

model Teacher {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String
  img       String?
  bloodType String
  sex       UserSex
  createdAt DateTime  @default(now())
  subjects  Subject[]
  lessons   Lesson[]
  classes   Class[]
  birthday  DateTime

  Question Question[]

  ExamCorrection ExamCorrection[]

  Quiz Quiz[]
}

model Parent {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String
  createdAt DateTime  @default(now())
  students  Student[]
}

model Class {
  id       Int    @id @default(autoincrement())
  name     String @unique
  capacity Int

  supervisorId  String?
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id], onDelete: SetNull)
  lessons       Lesson[]
  students      Student[]
  events        Event[]
  announcements Announcement[]

  Quiz Quiz[]

  Attendance Attendance[]
}

model Subject {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  teachers Teacher[]
  lessons  Lesson[]
  results  Result[]

  Quiz Quiz[]

  Attendance Attendance[]
}

model Lesson {
  id   Int    @id @default(autoincrement())
  name String
  day  Day

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId   Int
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  exams     Exam[]
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime

  lessonId Int
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  results  Result[]

  ExamAverage ExamAverage[]
}

model Result {
  id    Int @id @default(autoincrement())
  score Int

  examId    Int?
  exam      Exam?   @relation(fields: [examId], references: [id], onDelete: SetNull)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId, subjectId]) // Contrainte pour éviter les doublons
}

model ExamAverage {
  id        Int     @id @default(autoincrement())
  examId    Int
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  average   Float

  @@unique([examId, studentId]) // Contrainte pour éviter les doublons
}

model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   Int
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id], onDelete: SetNull)
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id], onDelete: SetNull)
}

model Quiz {
  id          String     @id @default(uuid())
  title       String     @unique
  date        DateTime
  duration    Int        // Durée de l'examen en minutes
  published   Boolean    @default(false)  // Contrôle de la publication des résultats
  teacherId   String
  teacher     Teacher    @relation(fields: [teacherId], references: [id])
  classId     Int
  class       Class      @relation(fields: [classId], references: [id])
  subjectId   Int
  subject     Subject    @relation(fields: [subjectId], references: [id])

  questions   Question[]
  StudentAnswer StudentAnswer[]

  ExamCorrection ExamCorrection[]
}

model Question {
  id            String    @id @default(uuid())
  questionText  String
  createdBy     String
  teacher       Teacher   @relation(fields: [createdBy], references: [id])
  quizId        String
  quiz          Quiz      @relation(fields: [quizId], references: [id])

  StudentAnswer StudentAnswer[]
}

model StudentAnswer {
  id          String    @id @default(uuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id])
  questionId  String
  question    Question  @relation(fields: [questionId], references: [id])
  answerText  String
  isCorrect   Boolean?  // Évaluation après correction
  submittedAt DateTime  @default(now())

  @@index([studentId])
  @@index([quizId])
  @@index([questionId])
  @@unique([studentId, quizId, questionId]) // Contrainte pour éviter les doublons
}

model ExamCorrection {
  id              String    @id @default(uuid())
  quizId          String
  quiz            Quiz      @relation(fields: [quizId], references: [id])
  correctedBy     String
  teacher         Teacher   @relation(fields: [correctedBy], references: [id])
  anonymousReview Boolean   @default(true)
  correctionDate  DateTime  @default(now())
}


enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}
